{
  "name": "@amplib/color",
  "description": "Color analysis utilities",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://amplib.app/color",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/another-machine/public-library.git",
    "directory": "packages/amplib-color"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
