    "watch": "tsup --watch",
    "test": "tsx test/run.ts",
    "prepack": "npm run build"
  },
  "author": "Another Machine",
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "tsx": "^4.19.2"
