{
  "name": "@amplib/steganography",
  "description": "Encoding data into images and decoding it back. The Stegassette (STGC) format carries audio and arbitrary entries in one PNG.",
  "version": "1.4.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://amplib.app/steganography",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/another-machine/public-library.git",
    "directory": "packages/amplib-steganography"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./job-schema": {
      "types": "./dist/jobSchema.d.ts",
      "default": "./dist/jobSchema.js"
    }
  },
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/node.ts",
      "src/jobSchema.js"
    ],
    "clean": true,
    "dts": true,
    "format": "esm",
    "minify": false,
    "sourcemap": true,
    "splitting": false,
    "external": [
      "pngjs"
    ]
  },
  "scripts": {
    "build": "tsup && npm run build:global",
    "build:global": "tsup src/stegassette.ts --format iife --global-name Stegassette --out-dir dist --sourcemap --no-dts --clean false && tsup src/jobSchema.js --format iife --global-name StegassetteJobs --out-dir dist --sourcemap --no-dts --clean false",
    "watch": "tsup --watch",
    "test:parity": "npm run build && node scripts/test-parity.mjs",
    "test:radial": "esbuild scripts/test-radial.ts --bundle --platform=node --format=esm --outfile=.tmp/radial.mjs --log-level=warning && node .tmp/radial.mjs",
    "build:types": "tsup --dts-only",
    "prepack": "npm run build"
  },
  "optionalDependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5"
  },
  "author": "Another Machine",
  "license": "Apache-2.0",
  "type": "module"
}
