{
  // Exists for the declaration build (`tsup --dts`). The JS bundle is built by
  // esbuild, which never type-checks — so without this file the .d.ts step is
  // the only thing standing between a type error and a published package.
  //
  // moduleResolution: "bundler" — matches amplib-steganography, and matches how
  // this package is actually consumed (Parcel for docs/* and machines/*, tsup
  // for the bundle). Under node16/nodenext the `astronomy-engine` import fails
  // with TS2792 because its "exports" map is resolved differently.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
