{
  // Exists for the declaration build (`tsup --dts`). The JS bundle is built by
  // esbuild, which never type-checks — so without this file the .d.ts step is
  // the only thing standing between a type error and a published package.
  //
  // moduleResolution: "bundler" — matches the sibling packages, and matches how
  // this one is consumed (Parcel for docs/* and machines/*, tsup for the
  // bundle). It is also what makes the `@amplib/music-theory` import resolve:
  // under the default resolution the dts build fails with TS2792 against that
  // package's "types" entry, while the esbuild bundle succeeds — so the JS
  // would ship and the declarations would not.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
