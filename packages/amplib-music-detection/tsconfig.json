{
  // Exists for the declaration build (`tsup --dts`). The JS bundle is built by
  // esbuild, which never type-checks — so without this file the .d.ts step is
  // the only thing standing between a type error and a published package.
  //
  // moduleResolution: "bundler" — matches the sibling packages, and matches how
  // this one is consumed (Parcel for docs/* and machines/*, tsup for the
  // bundle). It is also what makes the `@amplib/music-theory` import resolve:
  // under the default resolution the dts build fails with TS2792 against that
  // package's "types" entry, while the esbuild bundle succeeds — so the JS
  // would ship and the declarations would not.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // No `noEmit: false` alongside these. There is no `extends` here, so it is
    // already the default — and naming both keys is what TS5053 reports on.
    //
    // rootDir is the directory tsc already computes from `include`, written
    // down. TS 6 stops inferring it (TS6059), and an inferred root moves the
    // moment a file is added outside src/ — which would put dist/src/index.d.ts
    // where package.json's "types" says dist/index.d.ts.
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
