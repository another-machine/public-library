{
  "name": "@amplib/hue-wheel",
  "description": "A hue wheel divided into equal sectors, mapping hue to slots and back, in display and perceptual space.",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://amplib.app/hue-wheel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/another-machine/public-library.git",
    "directory": "packages/amplib-hue-wheel"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "clean": true,
    "dts": true,
    "format": "esm",
    "minify": false,
    "sourcemap": true,
    "splitting": false
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "test": "tsx test/run.ts",
    "prepack": "npm run build"
  },
  "author": "Another Machine",
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
