{
  "name": "@amplib/devices",
  "description": "A simplified interface for engaging with common MIDI devices and mapping actions to specific messages, user media, and device orientation.",
  "version": "0.2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://amplib.app/devices",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/another-machine/public-library.git",
    "directory": "packages/amplib-devices"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "clean": true,
    "dts": true,
    "format": "esm",
    "minify": false,
    "sourcemap": true,
    "splitting": false
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "prepack": "npm run build"
  },
  "author": "Another Machine",
  "license": "Apache-2.0",
  "type": "module"
}
